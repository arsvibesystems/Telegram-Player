<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/sidebar_action_bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/sidebar_action_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:tint="@color/sidebar_text"
        android:contentDescription="Action icon" />

    <TextView
        android:id="@+id/sidebar_action_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/sidebar_text"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>
